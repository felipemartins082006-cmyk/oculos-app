<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Sem internet e sem permissões: tudo fica só no celular. -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/LogbookTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Aparece no "Compartilhar" de outros apps (Arquivos, Discord, WhatsApp, e-mail…):
                 um arquivo de texto ou um texto copiado vira uma importação. -->
            <intent-filter android:label="@string/importar_no_logbook">
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/csv" />
                <data android:mimeType="application/vnd.ms-excel" />
                <data android:mimeType="application/octet-stream" />
            </intent-filter>

            <!-- "Abrir com → Logbook" ao tocar num .txt/.csv/.json no app de arquivos. -->
            <intent-filter android:label="@string/importar_no_logbook">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/csv" />
            </intent-filter>
        </activity>
    </application>
</manifest>
