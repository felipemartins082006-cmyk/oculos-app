<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/page"
    android:clipToPadding="false"
    android:fillViewport="true">

  <LinearLayout
      android:id="@+id/conteudo"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="20dp"
      android:paddingTop="20dp"
      android:paddingEnd="20dp"
      android:paddingBottom="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text"
        android:textSize="30sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Grave a tela do celular em vídeo e tire prints."
        android:textColor="@color/muted"
        android:textSize="15sp" />

    <!-- Aparece enquanto a gravação ou o modo de prints estiver ligado -->
    <LinearLayout
        android:id="@+id/painelSessao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/bg_aviso"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

      <TextView
          android:id="@+id/txtSessao"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="@color/text"
          android:textSize="20sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/txtSessaoDica"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="@color/muted"
          android:textSize="14sp" />

      <Button
          android:id="@+id/btnEncerrar"
          style="@style/Botao"
          android:layout_height="52dp"
          android:layout_marginTop="14dp"
          android:background="@drawable/bg_gravar"
          android:drawableStart="@drawable/ic_stop"
          android:text="Parar" />
    </LinearLayout>

    <Button
        android:id="@+id/btnGravar"
        style="@style/Botao"
        android:layout_height="76dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_gravar"
        android:drawableStart="@drawable/ic_record"
        android:text="Gravar a tela"
        android:textSize="21sp" />

    <Button
        android:id="@+id/btnPrint"
        style="@style/Botao"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_print"
        android:drawableStart="@drawable/ic_camera"
        android:text="Tirar prints" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:text="Depois de começar, o app vai para trás e aparece um botão flutuante (e botões na notificação) para tirar print, gravar e parar."
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView
        style="@style/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OPÇÕES" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

      <Switch
          android:id="@+id/swMic"
          style="@style/Opcao"
          android:text="Gravar com som do microfone" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/line" />

      <Switch
          android:id="@+id/swContagem"
          style="@style/Opcao"
          android:text="Contagem de 3 segundos antes de gravar" />

      <View
          android:layout_width="match_parent"
          android:layout_height="1dp"
          android:background="@color/line" />

      <Switch
          android:id="@+id/swBolha"
          style="@style/Opcao"
          android:text="Botão flutuante na tela" />
    </LinearLayout>

    <TextView
        style="@style/Titulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SEUS VÍDEOS E PRINTS" />

    <TextView
        android:id="@+id/txtVazio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card"
        android:padding="18dp"
        android:text="Nada ainda. Os vídeos ficam na Galeria em Filmes › GravaTela e os prints em Imagens › GravaTela."
        android:textColor="@color/muted"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/lista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
  </LinearLayout>
</ScrollView>
